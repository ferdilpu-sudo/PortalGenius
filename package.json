{
  "name": "portalgenius",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "preflight": "node scripts/preflight.mjs",
    "lint": "node scripts/quality/lint.mjs",
    "format:check": "node scripts/quality/format.mjs",
    "format:standard:check": "prettier --check package.json package-lock.json .prettierrc.json",
    "qa:production:readonly": "node --experimental-strip-types scripts/qa/productionReadOnlyPreflight.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "wrangler": "4.151.0",
    "prettier": "3.6.2"
  }
}
